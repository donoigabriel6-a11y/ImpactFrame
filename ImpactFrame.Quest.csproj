<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ImpactFrame</AssemblyName>
    <RootNamespace>ImpactFrame</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>
    <DefineConstants>QUEST;ANDROID</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Quest extracted assemblies path (actual structure) -->
  <PropertyGroup>
    <QuestAssembliesPath>$(USERPROFILE)\AppData\LocalLow\Stress Level Zero\Bonelab\Mods\QuestAssemblies</QuestAssembliesPath>
    <QuestCpp2IlOutPath>$(QuestAssembliesPath)\cpp2il_out</QuestCpp2IlOutPath>
    <QuestNet8Path>$(QuestAssembliesPath)\netstandard2.1\net8</QuestNet8Path>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader and Harmony from Quest net8 -->
    <Reference Include="MelonLoader">
      <HintPath>$(QuestNet8Path)\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(QuestNet8Path)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity Engine from Quest cpp2il_out -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(QuestCpp2IlOutPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- mscorlib from Quest (Il2Cpp) -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(QuestCpp2IlOutPath)\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Il2CppInterop.Runtime for Il2CppObjectBase -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(QuestNet8Path)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- SLZ Assemblies from Quest cpp2il_out (Il2Cpp prefixed) -->
    <Reference Include="SLZ.Marrow">
      <HintPath>$(QuestCpp2IlOutPath)\Il2CppSLZ.Marrow.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(QuestCpp2IlOutPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Include shared source files -->
    <Compile Include="ImpactFrameMod.cs" />
  </ItemGroup>
</Project>