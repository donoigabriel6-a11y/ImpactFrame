<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ImpactFrame</AssemblyName>
    <RootNamespace>ImpactFrame</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Game install path -->
  <PropertyGroup>
    <GamePath>C:\Program Files (x86)\Steam\steamapps\common\BONELAB</GamePath>
    <MelonLoaderPath>$(GamePath)\MelonLoader</MelonLoaderPath>
    <Cpp2IlOutPath>$(MelonLoaderPath)\Dependencies\Il2CppAssemblyGenerator\Cpp2IL\cpp2il_out</Cpp2IlOutPath>
    <Net472Path>$(MelonLoaderPath)\net472</Net472Path>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader and Harmony from net472 -->
    <Reference Include="MelonLoader">
      <HintPath>$(Net472Path)\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Net472Path)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity Engine from cpp2il_out -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Cpp2IlOutPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(Cpp2IlOutPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(Cpp2IlOutPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Cpp2IlOutPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- SLZ Assemblies from cpp2il_out -->
    <Reference Include="SLZ.Marrow">
      <HintPath>$(Cpp2IlOutPath)\SLZ.Marrow.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Cpp2IlOutPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>