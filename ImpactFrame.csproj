    <Reference Include="MelonLoader">
      <HintPath>$(USERPROFILE)\AppData\LocalLow\Stress Level Zero\Bonelab\MelonLoader\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
